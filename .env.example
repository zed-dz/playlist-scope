# API keys for the LLM and transcript proxies. Set whichever you have.
# At minimum, set one of: SUPADATA_API_KEY or GEMINI_API_KEY.

# RECOMMENDED: Supadata for fast, reliable transcript+metadata fetching
# Free tier: 100 requests/month, no credit card
# Sign up: https://supadata.ai
SUPADATA_API_KEY=

# For derived features (Ask, summaries, chapters) + transcript fallback
# Free tier: 250 requests/day, no credit card
# Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional, only needed for MCP exports to Notion/Drive/Gmail
# Pay-as-you-go after $5 free credit
# Get key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: override the Supabase ingest server URL
VITE_INGEST_URL=https://dccrfsxwmyqhghvtnabl.supabase.co/functions/v1/playlist-ingest
