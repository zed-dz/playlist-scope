# API keys for the LLM and transcript proxies. Set whichever you have —
# the proxy cascades through all configured keys, advancing on rate-limit /
# quota errors so the app stays up even when one provider runs out.

# ---------- Free LLM providers (configure 1+ for redundancy) ----------

# RECOMMENDED — Google Gemini. 1,500 req/day free, Search grounding, no card.
# Sign up: https://aistudio.google.com/apikey
# Key format: AIza…
GEMINI_API_KEY=

# Groq — Llama 3.3 70B, ~14k req/day, blazing fast (~500 tok/s). No card.
# Sign up: https://console.groq.com/keys
# Key format: gsk_…
GROQ_API_KEY=

# OpenRouter — free Llama 3.3 70B via :free models, 20 req/min, no daily cap.
# Sign up: https://openrouter.ai/keys
# Key format: sk-or-…
OPENROUTER_API_KEY=

# Cerebras — world-record-fast inference, 8k req/day free. No card.
# Sign up: https://cloud.cerebras.ai
# Key format: csk-…
CEREBRAS_API_KEY=

# ---------- Paid (optional, only for MCP exports) ----------

# Anthropic — required only for Notion / Drive / Gmail MCP exports. Pay-as-you-go.
# Sign up: https://console.anthropic.com/settings/keys
# Key format: sk-ant-…
ANTHROPIC_API_KEY=

# ---------- Transcript fetch (optional) ----------

# Supadata — fast transcript+metadata fetching, 100 req/month free.
# Sign up: https://supadata.ai
SUPADATA_API_KEY=

# Optional: override the Supabase ingest server URL
VITE_INGEST_URL=https://dccrfsxwmyqhghvtnabl.supabase.co/functions/v1/playlist-ingest
